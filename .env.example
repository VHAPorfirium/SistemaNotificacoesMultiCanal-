# ==========================================
#  App
# ==========================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ==========================================
#  Database
# ==========================================
DATABASE_URL="postgresql://notification:notification@localhost:5432/notification_db?schema=public"

POSTGRES_USER=notification
POSTGRES_PASSWORD=notification
POSTGRES_DB=notification_db

# ==========================================
#  Redis / BullMQ
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BULL_PREFIX=bull

# ==========================================
#  SMTP (MailHog em dev)
# ==========================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Notification Service <noreply@example.com>"

# ==========================================
#  SMS provider
# ==========================================
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_FROM=

# ==========================================
#  Push provider
# ==========================================
PUSH_PROVIDER_KEY=

# ==========================================
#  Auth / Secrets
#  Gere com: openssl rand -hex 32
# ==========================================
API_KEY=
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=
